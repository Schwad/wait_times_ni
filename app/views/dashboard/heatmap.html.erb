<div class="controls">
  <%= form_tag heatmap_path, method: :get, style: "display: flex; gap: 15px; align-items: center;" do %>
    <label>Select Hospital:</label>
    <%= select_tag :hospital_id, options_from_collection_for_select(@hospitals, :id, :name, @selected_hospital.id), onchange: "this.form.submit()" %>
  <% end %>
</div>

<div class="card">
  <h2>🗓️ Wait Time Heatmap - <%= @selected_hospital.name %></h2>
  <p style="color: var(--text-muted); margin-bottom: 20px; font-size: 0.9rem;">
    Average wait times by day of week and hour. Darker colors indicate longer waits.
  </p>
  
  <!-- Desktop: Full heatmap chart -->
  <div class="heatmap-desktop">
    <div id="heatmap-chart" style="min-height: 350px;"></div>
  </div>
  
  <!-- Mobile: Day-by-day card view -->
  <div class="heatmap-mobile">
    <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 16px;">
      📱 Swipe through days to see hourly patterns
    </p>
    <% days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'] %>
    <% days.each do |day| %>
      <% day_data = @heatmap_data.select { |d| d[:y] == day }.sort_by { |d| d[:x] } %>
      <% max_wait = [@heatmap_data.map { |d| d[:v] }.max, 1].max %>
      <details class="mobile-day-card">
        <summary style="cursor: pointer; font-weight: 600;"><%= day %></summary>
        <div style="margin-top: 12px;">
          <% day_data.each do |hour_data| %>
            <% wait = hour_data[:v] %>
            <% level = wait <= 30 ? 'low' : wait <= 60 ? 'medium' : wait <= 120 ? 'high' : 'very-high' %>
            <% width_pct = [(wait.to_f / 120 * 100), 100].min %>
            <div class="mobile-hour-row">
              <span class="mobile-hour-label"><%= sprintf("%02d:00", hour_data[:x]) %></span>
              <div class="mobile-wait-bar">
                <div class="mobile-wait-fill <%= level %>" style="width: <%= width_pct %>%;"></div>
              </div>
              <span class="mobile-wait-value" style="color: var(--<%= level == 'low' ? 'success' : level == 'medium' ? 'warning' : 'danger' %>);">
                <%= wait %> min
              </span>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
    
    <!-- Mobile legend -->
    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 16px; font-size: 0.8rem;">
      <span><span style="display: inline-block; width: 12px; height: 12px; background: var(--success); border-radius: 2px;"></span> Low (≤30 min)</span>
      <span><span style="display: inline-block; width: 12px; height: 12px; background: var(--warning); border-radius: 2px;"></span> Medium (31-60)</span>
      <span><span style="display: inline-block; width: 12px; height: 12px; background: var(--danger); border-radius: 2px;"></span> High (61-120)</span>
      <span><span style="display: inline-block; width: 12px; height: 12px; background: #7f1d1d; border-radius: 2px;"></span> Very High (120+)</span>
    </div>
  </div>
</div>

<div class="grid grid-2" style="margin-top: 20px;">
  <div class="card">
    <h2>📊 Lowest Average Waits</h2>
    <div style="margin-top: 15px;">
      <% best_times = @heatmap_data.sort_by { |d| d[:v] }.first(5) %>
      <% best_times.each_with_index do |time, idx| %>
        <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border);">
          <span>
            <span style="color: var(--success); font-weight: 600;"><%= idx + 1 %>.</span>
            <%= time[:y] %> at <%= time[:x] %>:00
          </span>
          <span style="font-weight: 600; color: var(--success);"><%= time[:v] %> min</span>
        </div>
      <% end %>
    </div>
  </div>
  
  <div class="card">
    <h2>📊 Highest Average Waits</h2>
    <div style="margin-top: 15px;">
      <% worst_times = @heatmap_data.sort_by { |d| -d[:v] }.first(5) %>
      <% worst_times.each_with_index do |time, idx| %>
        <div style="display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid var(--border);">
          <span>
            <span style="color: var(--danger); font-weight: 600;"><%= idx + 1 %>.</span>
            <%= time[:y] %> at <%= time[:x] %>:00
          </span>
          <span style="font-weight: 600; color: var(--danger);"><%= time[:v] %> min</span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
document.addEventListener('turbo:load', function() {
  var chartEl = document.querySelector("#heatmap-chart");
  if (!chartEl) return;
  chartEl.innerHTML = ''; // Clear any existing chart
  var rawData = <%= raw @heatmap_data.to_json %>;
  
  // Group by day
  var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  var series = days.map(function(day) {
    var dayData = rawData.filter(function(d) { return d.y === day; });
    return {
      name: day,
      data: dayData.map(function(d) { return { x: d.x + ':00', y: d.v }; })
    };
  });
  
  var options = {
    series: series,
    chart: {
      type: 'heatmap',
      height: 350,
      toolbar: { show: false }
    },
    dataLabels: {
      enabled: true,
      style: {
        colors: ['#fff'],
        fontSize: '10px'
      }
    },
    colors: ["#2563eb"],
    plotOptions: {
      heatmap: {
        shadeIntensity: 0.5,
        colorScale: {
          ranges: [
            { from: 0, to: 30, name: 'Low', color: '#10b981' },
            { from: 31, to: 60, name: 'Medium', color: '#f59e0b' },
            { from: 61, to: 120, name: 'High', color: '#ef4444' },
            { from: 121, to: 500, name: 'Very High', color: '#7f1d1d' }
          ]
        }
      }
    },
    xaxis: {
      type: 'category',
      title: { text: 'Hour of Day' }
    },
    yaxis: {
      title: { text: 'Day of Week' }
    },
    tooltip: {
      y: {
        formatter: function(val) { return val + ' minutes avg wait'; }
      }
    }
  };

  new ApexCharts(document.querySelector("#heatmap-chart"), options).render();
});
</script>
